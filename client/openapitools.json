{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "generator-cli": {
    "version": "7.26.0",
    "useDocker": true,
    "generators": {
      "client": {
        "generatorName": "typescript-fetch",
        "inputSpec": "../server/openapi.yaml",
        "output": "src/services",
        "globalProperty": {
          "apiDocs": false,
          "modelDocs": false,
          "apiTests": false,
          "modelTests": false
        },
        "additionalProperties": {
          "hideGenerationTimestamp": true
        }
      }
    }
  }
}
